USES CRT;

TYPE A=OBJECT
       CONSTRUCTOR INIT;
       PROCEDURE   AA  ; VIRTUAL ;
       PROCEDURE   AB  ; VIRTUAL ;
       DESTRUCTOR  DONE;
       END;
TYPE B=OBJECT (A)
       PROCEDURE   AA  ; VIRTUAL ;
       PROCEDURE   AB  ; VIRTUAL ;
       END;

CONSTRUCTOR A.INIT; BEGIN; END;
DESTRUCTOR A.DONE;  BEGIN; END;
PROCEDURE A.AA;     BEGIN; WRITELN('A.AA'); END;
PROCEDURE A.AB;     BEGIN; WRITELN('A.AB'); SELF.AA END;

PROCEDURE B.AA;     BEGIN; WRITELN('B.AA'); END;
PROCEDURE B.AB;     BEGIN; inherited AB; END;

VAR VA : b;

BEGIN;
CLRSCR;
VA.INIT;
VA.AB;
VA.DONE;
END.